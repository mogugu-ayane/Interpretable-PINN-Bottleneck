import torch
import torch.nn as nn
import numpy as np
import matplotlib.pyplot as plt

device = torch.device("cuda" if torch.cuda.is_available() else "mps" if torch.backends.mps.is_available() else "cpu")
print(f"사용 중인 디바이스: {device}")

torch.manual_seed(42)
np.random.seed(42)

import torch
import torch.nn as nn

class PINNBottleneck(nn.Module):
    def __init__(self, hidden_dim=64, bottleneck_dim=2, initial_dropout=0.1):
        """
        미지 동역학(u_dyn)을 추출하는 Low-Rank 병목 신경망.
        물리적 표현 용량을 극단적으로 제한하여 모델의 꼼수를 차단합니다.
        """
        super(PINNBottleneck, self).__init__()

        # 1. 극단적 차원 축소 (64 -> 2)
        self.compress = nn.Linear(hidden_dim, bottleneck_dim)

        # 2. C2-Continuous 활성화 함수 (PINN의 2차 미분을 위해 Tanh 또는 SiLU 필수)
        self.activation = nn.Tanh()

        # 3. 잔차 드롭아웃 (p_epsilon) - 미지 채널 의존도 방해
        self.dropout = nn.Dropout(p=initial_dropout)

        # 4. 최종 스칼라 출력 (2 -> 1)
        self.output = nn.Linear(bottleneck_dim, 1)

    def forward(self, h):
        """
        h: 공통 은닉층을 통과한 피처 벡터 (Shape: [Batch, hidden_dim])
        """
        x = self.compress(h)      # 물리적 용량 박탈 (W_u1)
        x = self.activation(x)    # 비선형성 부여
        u_dyn = self.output(x)    # 최종 오차 찌꺼기 출력 (W_u2)

        return u_dyn

