import torch
import torch.optim as optim
import torch.nn as nn

def train_pinn_burgers(model, data_dict, nu, adam_iters=5000, lbfgs_iters=5000):
    x_col, t_col = data_dict['col']
    x_ic, t_ic, u_ic = data_dict['ic']
    x_bc, t_bc, u_bc = data_dict['bc']

    # 🚨 영점 초기화
    for param in model.bottleneck.parameters():
        nn.init.zeros_(param)

    opt_adam_u = optim.Adam([{'params': model.net_u_hidden.parameters()}, {'params': model.W_u.parameters()}], lr=1e-3)
    opt_adam_dyn = optim.Adam([{'params': model.net_dyn_hidden.parameters()}, {'params': model.bottleneck.parameters()}], lr=1e-4)

    params_u_only = list(model.net_u_hidden.parameters()) + list(model.W_u.parameters())
    opt_lbfgs = optim.LBFGS(params_u_only, lr=1.0, max_iter=lbfgs_iters, line_search_fn="strong_wolfe")

    # ==========================================
    # 🚨 경계 조건 가중치 (IC/BC Dominance)
    # ==========================================
    weight_bc = 100.0

    model.train()
    print("--- Transitioning to Adam ---")
    for epoch in range(adam_iters):
        opt_adam_u.zero_grad()
        opt_adam_dyn.zero_grad()

        x_c = x_col.clone().detach().requires_grad_(True)
        t_c = t_col.clone().detach().requires_grad_(True)

        enable_dyn = (epoch >= 2000)

        loss_pde_u, loss_pde_dyn, loss_u_reg, loss_indep = compute_all_losses(model, x_c, t_c, nu, enable_dyn=enable_dyn)

        loss_ic = torch.mean((model(x_ic, t_ic)[0] - u_ic)**2)
        loss_bc = torch.mean((model(x_bc, t_bc)[0] - u_bc)**2)

        if not enable_dyn:
            # Phase 1: 순수 PINN 모드
            loss_total = weight_bc * (loss_ic + loss_bc) + loss_pde_u
            loss_total.backward()
            opt_adam_u.step()
        else:
            # Phase 2: 문서 Step 4의 궁극의 목적 함수 조합[cite: 1]
            loss_domain = loss_pde_u + loss_pde_dyn + loss_u_reg + loss_indep
            loss_total = weight_bc * (loss_ic + loss_bc) + loss_domain
            loss_total.backward()

            opt_adam_u.step()
            opt_adam_dyn.step()

        if epoch % 500 == 0:
            phase = "Phase 2 (Interpret)" if enable_dyn else "Phase 1 (Pure PINN)"
            print(f"[Adam] Epoch {epoch:4d} | {phase} | Total Loss: {loss_total.item():.6f}")

    print("--- Transitioning to L-BFGS ---")
    def closure():
        opt_lbfgs.zero_grad()
        x_c = x_col.clone().detach().requires_grad_(True)
        t_c = t_col.clone().detach().requires_grad_(True)

        loss_pde_u, _, _, _ = compute_all_losses(model, x_c, t_c, nu, enable_dyn=True)
        loss_ic = torch.mean((model(x_ic, t_ic)[0] - u_ic)**2)
        loss_bc = torch.mean((model(x_bc, t_bc)[0] - u_bc)**2)

        # 🚨 L-BFGS에도 100배 가중치 유지 (구불구불한 꼼수 완벽 차단)
        loss_total = weight_bc * (loss_ic + loss_bc) + loss_pde_u
        loss_total.backward()
        return loss_total

    opt_lbfgs.step(closure)
    print(f"[L-BFGS] Optimization Completed. Final Loss: {closure().item():.6f}")

    return model
